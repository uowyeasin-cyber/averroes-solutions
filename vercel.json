{
  "cleanUrls": true,
  "functions": {
    "api/*.js": {
      "includeFiles": "{data/**,home.html}"
    }
  },
  "rewrites": [
    {
      "source": "/api/login",
      "destination": "/api/auth?a=login"
    },
    {
      "source": "/api/logout",
      "destination": "/api/auth?a=logout"
    },
    {
      "source": "/api/me",
      "destination": "/api/auth?a=me"
    },
    {
      "source": "/api/status",
      "destination": "/api/meta?a=status"
    },
    {
      "source": "/api/versions",
      "destination": "/api/meta?a=versions"
    },
    {
      "source": "/",
      "destination": "/api/home"
    },
    {
      "source": "/services/:slug",
      "destination": "/api/page?kind=service&slug=:slug"
    },
    {
      "source": "/guides/:slug",
      "destination": "/api/page?kind=guide&slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/autopilot",
      "schedule": "0 3 * * 1"
    }
  ]
}
